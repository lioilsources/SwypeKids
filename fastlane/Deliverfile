# Lokalizované snímky do App Store Connect (jen snímky, žádné texty ani build).
#
#   python3 tool/store_captions.py
#   APP_STORE_CONNECT_API_KEY_PATH=~/…/swypekids_asc.json fastlane deliver
#
# JSON klíče: {"key_id": "…", "issuer_id": "…", "key_filepath": "…/AuthKey_….p8"}
# (stejný klíč, jaký má CI v secretech APP_STORE_CONNECT_API_*). Verze musí
# být v App Store Connect ve stavu „Prepare for Submission“; deliver ji
# k recenzi neodešle.
app_version("2.17.3")
screenshots_path("./build/store/fastlane/screenshots")
overwrite_screenshots(true)
skip_screenshots(false)
skip_metadata(true)
skip_binary_upload(true)
submit_for_review(false)
run_precheck_before_submit(false)
force(true) # bez HTML náhledu a potvrzování
